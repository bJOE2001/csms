NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use a Supabase publishable key here. Existing legacy anon keys also remain compatible.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
APP_URL=http://127.0.0.1:3000
# Optional server runtime overrides. Set both together; use the anon/public key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Public menu: apply the public-menu migration, then explicitly publish the shop in the database.
# The website uses the existing public key above; no service-role key is needed.
# Optional only when more than one shop is published. A single published shop is selected automatically.
# PUBLIC_MENU_SHOP_ID=the-existing-published-shop-uuid
# Verified visit details only. Unset values remain unpublished in production.
# SITE_ADDRESS=
# SITE_OPENING_HOURS=
# SITE_CONTACT_EMAIL=
# SITE_CONTACT_PHONE=
# Optional override; defaults to the owner's https://maps.app.goo.gl/JFPkDck15BBvFdLe9 link.
# SITE_DIRECTIONS_URL=https://...
# SITE_INSTAGRAM_URL=https://...
# SITE_FACEBOOK_URL=https://...

# Verified public origin for canonical URLs, social sharing images and sitemap.
# SITE_URL=https://your-verified-public-domain.example
# Optional owner-approved external ordering channel. Otherwise no public ordering UI is shown.
# SITE_ORDERING_URL=https://...
# Optional comma-separated existing product UUIDs. Available products only.
# SITE_FEATURED_PRODUCT_IDS=
# Default owner-confirmed address: Purok 6, Ising, Carmen, Davao del Norte
# Default owner-confirmed hours: 5:00 PM–9:00 PM. Operating days not yet supplied.
